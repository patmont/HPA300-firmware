# Optional Lovelace card for the HPA300 custom integration.
# Entity IDs can differ if the device or entities were renamed in Home Assistant.
type: vertical-stack
cards:
  - type: tile
    entity: fan.hpa300
    name: HPA300
    features:
      - type: fan-speed
  - type: grid
    columns: 4
    square: false
    cards:
      - type: button
        entity: fan.hpa300
        name: 25%
        icon: mdi:fan-speed-1
        tap_action:
          action: call-service
          service: fan.set_percentage
          target:
            entity_id: fan.hpa300
          data:
            percentage: 25
      - type: button
        entity: fan.hpa300
        name: 50%
        icon: mdi:fan-speed-1
        tap_action:
          action: call-service
          service: fan.set_percentage
          target:
            entity_id: fan.hpa300
          data:
            percentage: 50
      - type: button
        entity: fan.hpa300
        name: 75%
        icon: mdi:fan-speed-2
        tap_action:
          action: call-service
          service: fan.set_percentage
          target:
            entity_id: fan.hpa300
          data:
            percentage: 75
      - type: button
        entity: fan.hpa300
        name: 100%
        icon: mdi:fan-speed-3
        tap_action:
          action: call-service
          service: fan.set_percentage
          target:
            entity_id: fan.hpa300
          data:
            percentage: 100
  - type: history-graph
    title: HPA300 activity
    hours_to_show: 24
    entities:
      - entity: fan.hpa300
      - entity: sensor.hpa300_control_source
      - entity: sensor.hpa300_last_activity
      - entity: binary_sensor.hpa300_fan_fault
  - type: entities
    title: Device information
    entities:
      - entity: sensor.hpa300_shutoff_timer
      - entity: sensor.hpa300_control_state
      - entity: sensor.hpa300_last_boot
      - entity: sensor.hpa300_uptime
      - entity: sensor.hpa300_free_memory
      - entity: binary_sensor.hpa300_wifi
      - entity: binary_sensor.hpa300_maintenance
